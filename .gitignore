# 虚拟环境与依赖
.venv/
venv/

# Python 编译缓存
__pycache__/
*.py[cod]

# 本地临时产物：测试音频、探针输出、一次性日志
tmp/
*.log

# 编辑器 / 系统
.vscode/
.idea/
Thumbs.db
Desktop.ini

# 插件安装时渲染出来的机器路径与构建产物（仓库里只留 *.template）
plugins/voice-pill/.mcp.json
plugins/voice-pill/hooks/hooks.json
plugins/voice-pill/voicepill.exe
# Claude Code 侧同理：exe 是构建产物，persona.md 是从 plugins/voice-pill 渲染过来的
# 副本（人设的源只有那一份，见 ANC 的「双源手抄」那条）。
plugins/claude-code/voicepill.exe
plugins/claude-code/persona.md

# exe 换装时的旧份：被运行中的 MCP 进程钉着，重启 Codex 之后才删得掉
plugins/voice-pill/voicepill.exe.old*
plugins/claude-code/voicepill.exe.old*
